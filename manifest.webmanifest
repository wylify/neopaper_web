{
  "id": "./",
  "name": "NEOPAPER",
  "short_name": "NEOPAPER",
  "description": "Device-label wallpapers with your contact QR and a reader-app barcode. Works offline; everything stays on your device.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#0E0E11",
  "theme_color": "#0E0E11",
  "categories": ["design", "utilities", "productivity"],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/favicon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "shortcuts": [
    { "name": "New card", "url": "./?open=new", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Scan a code", "url": "./?open=scan", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
